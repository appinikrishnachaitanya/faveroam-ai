QLOO_API_KEY=
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# Cloud Run: use its attached service account, not a Gemini API key.
# GEMINI_AUTH_MODE=vertex-iam
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Local/Express Mode alternative (server only; no project or location needed)
# GEMINI_AUTH_MODE=express-key
GEMINI_API_KEY=
# Optional alternative key name; GOOGLE_API_KEY takes precedence when set.
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Metadata-only debug logs, optional
AGENT_DEBUG=0
# Safe info/error logs are on by default. Use error for errors only.
LOG_LEVEL=info
# Optional private query inspector; works only with npm run dev
QLOO_DEBUG_UI=0

# Optional OpenAI-compatible tool-calling provider (server only)
AGENT_MODEL_API_KEY=
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=

# Firebase Auth + Firestore + Cloud Storage (server only; ADC on Cloud Run)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
GCP_STORAGE_BUCKET=
# Canonical HTTPS origin in production; no trailing slash.
APP_ORIGIN=

# Optional kill switch for native Gemini's bounded MCP tool-observation loop
# AGENT_TOOL_LOOP=0
